<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hkh.sa.admin.module.system.role.dao.RoleMenuDao">
    <delete id="deleteByRoleId">
        delete
        from sys_role_menu
        where role_id = #{roleId}
    </delete>
    <select id="queryMenuIdByRoleId" resultType="java.lang.Long">
        select menu_id
        from sys_role_menu
        where role_id = #{roleId}
    </select>
    <select id="queryAllRoleMenu"
            resultType="com.hkh.domain.entity.role.RoleMenuEntity">
        select *
        from sys_role_menu
    </select>

    <select id="selectMenuListByRoleIdList"
            resultType="com.hkh.domain.entity.MenuEntity">
        SELECT
        distinct sys_menu.*
        from sys_menu
        left join sys_role_menu on sys_role_menu.menu_id = sys_menu.menu_id
        <where>
            <if test="deletedFlag != null">
                and sys_menu.deleted_flag = #{deletedFlag}
            </if>
            <if test="roleIdList != null and roleIdList.size > 0">
                and sys_role_menu.role_id in
                <foreach collection="roleIdList" open="(" close=")" item="item" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
        ORDER BY sys_menu.sort ASC
    </select>
</mapper>